/* Disable Auto Zoom in Input - Safari on iPhone https://stackoverflow.com/a/6394497 */
@media screen and (max-width: 767px) {
    input,
    select,
    textarea {
        font-size: 1rem;
    }
}

.loginWrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.login {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: 64px 24px 24px;
    box-sizing: border-box;

    @media screen and (min-width: 1024px) {
        padding-top: 96px;

    }
}

.formContainer {
    width: 100%;
    max-width: 576px;
    padding: 48px 16px 16px;
    box-sizing: border-box;
}


.listContainer {
    padding: 0 16px;
    width: 100%;
    max-width: 576px;
    box-sizing: border-box;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
}

.info {
    position: relative;
    text-align: center;
    text-decoration: none;
    overflow: hidden;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 130%;
}

.message,
.link {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
}

.link {
    margin-top: 16px;
    border: 0;
    background: transparent;
}

@media screen and (min-width: 992px) {
    .message {
        position: absolute;
        top: 40px;
        padding: 0 15px;
    }
}

.group {
    margin-bottom: 24px;
}

.footer {
    display: flex;
    justify-content: space-between;
    align-items: center;

    @media screen and (max-width: 480px) {
        align-items: stretch;
        flex-direction: column;
        gap: 18px;
    }
}

.button {
    max-width: 200px;

    @media screen and (max-width: 480px) {
        max-width: none;
    }
}

.title {
    font-size: clamp(34px, 6vw, 48px);
    padding: 0;
    font-style: normal;
    font-weight: 700;
    line-height: 110%;
    letter-spacing: -0.04em;
}

.eyebrow {
    margin-bottom: 8px;
    color: var(--product-tertiary-40);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.18em;
}

.subtitle {
    margin: 12px 0 8px;
    color: var(--default-description-text);
    line-height: 1.6;
}

.titleList {
    margin-bottom: 32px;
    padding: 0 16px;
}

.listDesc {
    margin-bottom: 24px;
}

.listItem {
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
}

.list {
    margin-bottom: 24px;
    padding: 0 16px;
}
