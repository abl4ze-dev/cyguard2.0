.header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0 16px;
    margin: 0 0 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--default-item-divider);

    @media (min-width: 1024px) {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 32px 16px;
        padding: 0 0 24px;
    }
}

.headerLeft {
    display: flex;
    flex-direction: column;
    gap: 16px;

    @media (min-width: 768px) {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
    }

    @media (min-width: 1024px) {
        flex: 1;
    }
}

.commandHeading {
    width: 100%;

    & span {
        color: var(--product-tertiary-40);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
    }

    & h1 {
        margin: 6px 0 4px;
        font-size: clamp(28px, 4vw, 42px);
        line-height: 1.08;
        letter-spacing: -0.035em;
    }

    & p {
        margin: 0;
        color: var(--default-description-text);
    }

    @media (min-width: 768px) {
        flex-basis: 100%;
    }
}

.statusBadge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    padding: 7px 11px;
    border: 1px solid;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.1em;
}

.protected {
    color: var(--cyguard-status-ok);
    border-color: var(--cyguard-cyan-border);
    background: var(--cyguard-cyan-soft);
}

.inactive {
    color: var(--cyguard-status-warning);
    border-color: var(--cyguard-orange-border);
    background: var(--cyguard-orange-soft);
}

.statusDot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
}

.headerRight {
    display: flex;
    flex-direction: column;
    gap: 16px;

    @media (min-width: 768px) {
        align-items: center;
        flex-direction: row;
    }
}

.toggleRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    @media (min-width: 768px) {
        position: relative;
        top: 2px;
        margin-left: 8px;
    }
}

.periodSelect {
    width: 100%;
    min-width: 0;

    @media (min-width: 768px) {
        width: auto;
        max-width: 100%;

        &:global(.react-select.react-select-responsive) {
            width: fit-content;
            max-width: 100%;
            min-width: 0;
        }
    }

    & :global(.select__control) {
        min-width: 100%;
        max-width: 100%;
    }

    & :global(.select__value-container) {
        min-width: 0;
        max-width: 100%;
    }

    & :global(.select__single-value) {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
}

.protectionMenu {
    min-width: 200px;

    @media (min-width: 768px) {
        min-width: 320px;
    }
}

.protectionMenuItem {
    padding-right: 24px;
}

.periodSettingsFooter {
    align-items: flex-start;
    padding: 24px 16px;
    border-top: 1px solid var(--default-item-divider);
}

.titleRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;

    @media (min-width: 768px) {
        display: none;
    }
}

.refreshButton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px;
    font-size: 16px;
    color: var(--default-main-text);
    border: 0;
    background: none;
    border-radius: 8px;
    cursor: pointer;
    transition: var(--t2) background-color;

    &:hover,
    &:focus {
        background: var(--hovered-secondary-button);
    }

    &:active {
        background: var(--pressed-secondary-button);
    }

    &:disabled {
        background: var(--disabled-secondary-button);
        color: var(--disabled-secondary-button-stroke);
        cursor: default;
    }

    & svg {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
    }
}

.refreshDesktopButton {
    width: fit-content;
}

.refreshMobileButton {
    width: 32px;
    height: 32px;
    padding: 0;
}

.onlyMobile {
    @media (min-width: 768px) {
        display: none;
    }
}

.onlyDesktop {
    display: none;

    @media (min-width: 768px) {
        display: flex;
    }
}

.protectionToggle {
    display: flex;
    align-items: center;
    gap: 16px;
}

.cardSubtitle {
    position: relative;
    top: 2px;
    font-size: 14px;
    color: var(--default-description-text);
}
