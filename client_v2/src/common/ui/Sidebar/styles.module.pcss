.sidebarWrapper {
    display: block;
    min-width: 264px;

    @media (min-width: 1200px) {
        align-self: stretch;
        background: linear-gradient(
            180deg,
            var(--cyguard-sidebar-start) 0%,
            var(--cyguard-sidebar-end) 100%
        );
        border-right: 1px solid var(--default-item-divider);
    }
}

.sidebarContainer {
    display: none;
    flex-shrink: 0;

    @media (min-width: 1200px) {
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        width: 100%;
        max-width: 264px;
        height: 100vh;
        padding: 18px 0;
        overflow-y: auto;
        z-index: 1;
        background: transparent;
    }

    &::-webkit-scrollbar {
        display: none;
    }
}

.sidebar {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

.logo {
    width: 184px;
    height: 40px;
}

.linkWrapper {
    display: flex;
    padding: 4px 22px 28px;
}

.link {
    text-decoration: none;
}

.logoWordmark {
    fill: var(--cyguard-sidebar-heading);
}
