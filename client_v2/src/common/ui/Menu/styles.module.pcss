.menu {
    padding-top: 8px;
    display: none;
    box-shadow: var(--main-box-shadow);
    min-height: 100vh;
    max-width: 240px;
    flex-shrink: 0;
    z-index: 1;

    @media (min-width: 1200px) {
        display: flex;
        flex-direction: column;
    }
}

.menuWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100vh - 80px);
    padding-bottom: env(safe-area-inset-bottom);

    @media (min-width: 1200px) {
        min-height: 0;
        flex: 1;
    }

    &.headerMenu {
        min-height: 100%;
        justify-content: flex-start;
        gap: 80px;
    }
}

.menuLink,
.accordionLink {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 2px 12px;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 21px;
    font-weight: var(--weight-regular);
    color: var(--cyguard-sidebar-text);
    text-decoration: none;
    max-width: 100%;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    vertical-align: middle;
    transition:
        background-color var(--t2),
        color var(--t2);
    outline: none;

    &:hover,
    &:focus {
        color: var(--cyguard-sidebar-heading);
        background-color: var(--cyguard-accent-soft);
        text-decoration: none;
    }

    &.activeLink {
        color: var(--cyguard-sidebar-heading);
        background: linear-gradient(
            90deg,
            var(--cyguard-accent-strong),
            var(--cyguard-accent-fade)
        );
        box-shadow: inset 2px 0 var(--product-tertiary-40);

        .linkIcon {
            color: var(--product-tertiary-40);
        }
    }
}

.accordionLink {
    margin-left: 24px;
    padding: 9px 12px 9px 28px;
}

.linkIcon {
    color: var(--cyguard-sidebar-muted);
    transition: color var(--t2);
}

.withConfirmIcon {
    display: flex;
    align-items: center;
}

.topMenuWrapper {
    margin-bottom: auto;

    @media (min-width: 1200px) {
        margin-bottom: 0;
    }
}

.referenceWrapper {
    margin-top: auto;
}

.accordionHeader {
    cursor: pointer;
    user-select: none;
}

.accordionArrow {
    margin-left: auto;
    color: var(--default-gray-icons);
    transition:
        transform var(--t2),
        color var(--t2);
}

.sectionLabel {
    margin: 18px 24px 8px;
    color: var(--cyguard-sidebar-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
}

.productMeta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 18px 24px 12px;
    color: var(--cyguard-sidebar-heading);
    font-size: 11px;
    letter-spacing: 0.08em;

    & span {
        color: var(--cyguard-sidebar-muted);
        font-size: 9px;
    }
}

.accordionArrowOpen {
    transform: rotate(180deg);
}
